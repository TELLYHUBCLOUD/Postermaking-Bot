# ── Telegram (REQUIRED) ────────────────────────────────────────────────
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token
# MongoDB connection string (REQUIRED for premium/authorize/settings)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
# Owner Telegram ID from @userinfobot (REQUIRED)
OWNER_ID=123456789

# ── TMDB (needed for /tmdb, /magic, /premiere) ─────────────────────────
# Use either a v4 Bearer token OR a v3 API key:
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# ── Optional tweaks ────────────────────────────────────────────────────
# Daily poster limits per tier
# LIMIT_DEFAULT=20
# LIMIT_BRONZE=30
# LIMIT_SILVER=40
# LIMIT_GOLD=50

# Branding shown on posters / thumbnails
# POWERED_BY=@Blaze_Updatez
# CREATED_BY=@Bharath_boy
# UPDATE_CHANNEL=Blaze_Updatez

# Thumbnail branding (users can override via /settings)
# THUMBNAIL_BRAND=@YourChannel
# THUMBNAIL_CHANNEL=YourChannel
# THUMBNAIL_QUALITY_TAGS=1080p,HD

# Render/PaaS port for the health server
# PORT=10000
